                <mxCell id="PjiNqZ8FesJvhq1ty-pc-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;p&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;REST — Uniform Interface Rules&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Base URL:&lt;/strong&gt; &lt;code&gt;/api/v1&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Resource Naming:&lt;/strong&gt; Plural nouns (&lt;code&gt;/products&lt;/code&gt;, &lt;code&gt;/orders&lt;/code&gt;, &lt;code&gt;/engines&lt;/code&gt;).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;HTTP Methods:&lt;/strong&gt; GET = Read, POST = Create/Action, PATCH = Partial Update, DELETE = Remove.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Request Format:&lt;/strong&gt; JSON (&lt;code&gt;Content-Type: application/json&lt;/code&gt;); CSV upload uses &lt;code&gt;multipart/form-data&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Success Response:&lt;/strong&gt; &lt;code&gt;{ &quot;success&quot;: true, &quot;data&quot;: {...} }&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Error Response:&lt;/strong&gt; &lt;code&gt;{ &quot;success&quot;: false, &quot;error&quot;: { &quot;code&quot;: &quot;...&quot;, &quot;message&quot;: &quot;...&quot; } }&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;HTTP Status:&lt;/strong&gt; 200 OK, 201 Created, 400 Bad Request, 401 Unauthorized, 403 Forbidden, 404 Not Found, 409 Conflict, 500 Internal Error.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Authentication:&lt;/strong&gt; &lt;code&gt;Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;/code&gt; for protected endpoints.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;strong&gt;Consistency:&lt;/strong&gt; Same URL conventions, request/response structure, and error handling across all API modules.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="558" width="220" x="30" y="300" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
