                <mxCell id="p04-n-org" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Organization ownership (purple edges)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Buyer:&lt;/b&gt; users.company_id = aircraft.company_id → engines → sensor_uploads → rul_predictions; orders.buyer_company_id.&lt;br&gt;&lt;b&gt;Supplier:&lt;/b&gt; suppliers.company_id → seller_listings.supplier_id, seller_orders.supplier_id.&lt;br&gt;companies.company_type = MIXED is not a user role.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="150" width="600" x="40" y="1300" as="geometry"/>
                </mxCell>
                <mxCell id="p04-n-st" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Private object storage references (ST-01)&lt;/b&gt;&lt;br&gt;sensor_uploads.object_key · ml_model_versions.model_object_key / scaler_object_key · product_images.object_key · suppliers.logo_object_key — keys, never public URLs&lt;/font&gt;." vertex="1">
                    <mxGeometry height="150" width="600" x="660" y="1300" as="geometry"/>
                </mxCell>
                <mxCell id="p04-n-ord" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Multi-supplier checkout chain (blue edges)&lt;/b&gt;&lt;br&gt;orders 1─&amp;lt; seller_orders (UQ order_id, supplier_id) 1─&amp;lt; order_items · orders 1─1 payments (SIMULATION/SUCCEEDED) · seller_orders 1─1 shipments. Overall status derived from seller_orders; no cancellation/refund. Stock deducted on seller_listings in TX-01.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="110" width="540" x="1285" y="1315" as="geometry"/>
                </mxCell>
                <mxCell id="p04-n-ai" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;AI prediction chain (teal edges)&lt;/b&gt;&lt;br&gt;engines 1─&amp;lt; sensor_uploads 1─&amp;lt; rul_predictions 1─&amp;lt; replacement_recommendations &amp;gt;─1 seller_listings. Prediction status ≠ recommendation_status (SUCCEEDED may yield NO_MATCH). listing_snapshot immutable; checkout rechecks live price/stock.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="110" width="660" x="1850" y="1310" as="geometry"/>
                </mxCell>
                <mxCell id="p04-n-users" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#A1887F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontFamily=Helvetica;fontColor=#1A1A1A;fontSize=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FKs → users not drawn as edges&lt;/b&gt; (legibility): carts.user_id, cart_items via carts, wishlist_items.user_id, sensor_uploads.uploaded_by, rul_predictions.requested_by, orders.placed_by, reviews.reviewer_user_id, notifications.user_id; also orders.buyer_company_id → companies. All are listed in table text.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="120" width="700" x="1290" y="1480" as="geometry"/>
                </mxCell>
                <mxCell id="p04-db-cyl" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;DB-01 PostgreSQL OLTP&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;26 = 4 + 6 + 2 + 4 + 3 + 5 + 2&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;host  · live DDL &lt;/font&gt;" vertex="1">
                    <mxGeometry height="170" width="260" x="1425" y="1068" as="geometry"/>
