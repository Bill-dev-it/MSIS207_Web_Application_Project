                <mxCell id="p07-e1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#6E569E;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;" value="&lt;div style=&quot;font-family:Helvetica,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;border-bottom:1.5px solid #C6B7E2;padding-bottom:6px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;gap:6px;&quot;&gt;&lt;div style=&quot;font-size:21.5px;font-weight:700;color:#123056;line-height:1.18;&quot;&gt;1 · Checkout Request&lt;/div&gt;&lt;span style=&quot;flex-shrink:0;padding:2px 8px;border-radius:4px;font-size:14px;font-weight:700;background:#F1F5F9;border:1px solid #94A3B8;color:#123056;white-space:nowrap;&quot;&gt;BE-05&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;font-weight:600;color:#475569;margin-top:3px;&quot;&gt;Addresses, delivery &amp;amp; key&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;div style=&quot;margin-top:7px;font-size:18px;line-height:1.35;color:#1E293B;&quot;&gt;&lt;code&gt;POST /api/v1/checkout/orders&lt;/code&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:18px;line-height:1.35;color:#1E293B;&quot;&gt;Reads shared &lt;code&gt;cart_items&lt;/code&gt; for Buyer company&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:18px;line-height:1.35;color:#1E293B;&quot;&gt;Enforces idempotent &lt;code&gt;checkout_key&lt;/code&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
