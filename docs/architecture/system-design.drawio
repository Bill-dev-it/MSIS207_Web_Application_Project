gt;Insufficient stock or failure &amp;rarr; full ROLLBACK (409 / 5xx)&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="274" width="790" x="594" y="1226" as="geometry"/>
