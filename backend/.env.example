PORT=5000
NODE_ENV=development

# PostgreSQL (existing convention: DB_* variables, see src/config/db.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aviation_b2b
DB_USER=postgres
DB_PASSWORD=change-me

# Auth: JWT stored in an httpOnly cookie
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Allowed browser origin (CORS, credentials)
CORS_ORIGIN=http://localhost:5173

# RUL inference service (used by Admin → RUL Health Check). Leave empty if not running.
RUL_SERVICE_URL=
