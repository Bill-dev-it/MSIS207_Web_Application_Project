              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Order detail preserves BIGINT order_id as string and includes seller_orders and payment', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.order_id).to.be.a('string');",
                  "  pm.expect(body.data.seller_orders).to.be.an('array');",
                  "  pm.expect(body.data).to.include.keys('order_number', 'company_name_snapshot', 'grand_total', 'primary_status', 'payment');",
                  "});"
                ]
              }
            }
