    "name": "AeroRUL - Admin Orders API",
    "description": "Read-only Postman Collection for AeroRUL Admin Orders API testing (TC01 - TC15) against live Express backend and PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
