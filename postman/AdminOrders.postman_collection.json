  "item": [
    {
      "name": "1. Orders List, Search, Filter & Pagination",
      "item": [
        {
          "name": "TC01 - Retrieve Admin Orders List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response envelope has success=true and items/counts/pagination', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.items).to.be.an('array');",
                  "  pm.expect(body.data.counts).to.have.all.keys('ALL', 'CONFIRMED', 'PROCESSING', 'SHIPPED', 'DELIVERED');",
                  "  pm.expect(body.data.pagination).to.include.keys('page', 'limit', 'total', 'totalPages');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "aerorul_session={{sessionCookie}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "orders"]
            }
          }
        },
        {
          "name": "TC02 - Retrieve Orders with Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Pagination returns page=1 and limit=2', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.items.length).to.be.at.most(2);",
                  "  pm.expect(body.data.pagination.page).to.eql(1);",
                  "  pm.expect(body.data.pagination.limit).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "aerorul_session={{sessionCookie}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/orders?page=1&limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "2" }
              ]
            }
          }
        },
