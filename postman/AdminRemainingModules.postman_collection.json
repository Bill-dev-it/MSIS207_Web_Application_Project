  "item": [
    {
      "name": "1. Companies / Buyers",
      "item": [
        {
          "name": "01 - Auth Required Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/companies"
          }
        },
        {
          "name": "02 - Forbidden For Non-Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "aerorul_session={{buyerSessionCookie}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/companies"
          }
        },
        {
          "name": "03 - List All Buyer Companies",
