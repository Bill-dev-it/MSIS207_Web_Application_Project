          }
        },
        {
          "name": "24 - Validate Invalid Settings Input",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "aerorul_session={{adminSessionCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currency\":\"USD\",\"default_shipping_estimate\":\"3-5 business days\",\"supplier_approval_required\":true,\"product_moderation\":false,\"rul_thresholds\":{\"prioritize_at_or_below\":50,\"prepare_at_or_below\":40,\"monitor_at_or_below\":80,\"normal_above\":80},\"demo_payment_mode\":true}"
            },
