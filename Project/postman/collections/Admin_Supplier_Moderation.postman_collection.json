{
  "info": {
    "_postman_id": "a90e38a2-11c4-4b47-b844-315182103f19",
    "name": "AeroRUL - Admin Supplier Moderation",
    "description": "Postman Collection for Admin Dashboard & Supplier Moderation API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Admin Login (Nhận Token & Session)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.success && res.data && res.data.token) {",
              "    pm.environment.set('adminToken', res.data.token);",
              "    pm.collectionVariables.set('adminToken', res.data.token);",
              "    console.log('Admin token saved successfully!');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-AeroRUL-Request", "value": "1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@aerorul.example\",\n  \"password\": \"AdminPassword123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "1. Admin Dashboard Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "dashboard"]
        }
      }
    },
    {
      "name": "2. API 1 - Lấy danh sách Supplier (PENDING)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/suppliers?status=PENDING&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "suppliers"],
          "query": [
            { "key": "status", "value": "PENDING" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "3. API 2 - Lấy chi tiết Supplier (ID = 1)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/suppliers/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "suppliers", "1"]
        }
      }
    },
    {
      "name": "4. API 3 - Approve Supplier (PENDING -> APPROVED)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-AeroRUL-Request", "value": "1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/suppliers/{{supplierId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "suppliers", "{{supplierId}}", "status"]
        }
      }
    },
    {
      "name": "5. API 4 - Suspend Supplier (APPROVED -> SUSPENDED)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-AeroRUL-Request", "value": "1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/suppliers/{{supplierId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "suppliers", "{{supplierId}}", "status"]
        }
      }
    },
    {
      "name": "6. API 5 - Reactivate Supplier (SUSPENDED -> APPROVED)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-AeroRUL-Request", "value": "1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/suppliers/{{supplierId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "suppliers", "{{supplierId}}", "status"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": "38"
    }
  ]
}

